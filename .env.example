# Claude API (KI-Beschreibungen, Kommentar-Aufbereitung, Report-Zusammenfassung)
ANTHROPIC_API_KEY=
# Optional: anderes Modell
ANTHROPIC_MODEL=claude-opus-5-5

# Erstes Admin-Konto (wird nur beim allerersten Start angelegt)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Speicherort der SQLite-Datenbank
DATABASE_PATH=./data/checklisten.db

# Demo-Daten (Beispiel-Checkliste und Demo-Nutzer) beim ersten Start anlegen
SEED_DEMO=true
